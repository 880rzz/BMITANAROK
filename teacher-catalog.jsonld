    {
      "@type": "Person",
      "@id": "https://tanarok.magyariskola.at/#balogh-david",
      "name": "Balogh Dávid",
      "jobTitle": "Művészettörténész · muzeológus · fotográfiai foglalkozásvezető",
      "description": "A fotográfiát történeti, vizuális és kulturális összefüggéseiben értelmezem. Előadásaimban egy-egy fotográfus vagy korszak munkásságát a történeti háttér, a technika, az érzelmi hatás és a művészeti jelentés felől is vizsgálom, külön figyelemmel a festészet és a fotográfia kapcsolatára.",
      "url": "https://tanarok.magyariskola.at/#balogh-david",
      "affiliation": {
        "@id": "https://www.magyariskola.at/#school"
      }
    },
    {
      "@type": "Person",
      "@id": "https://tanarok.magyariskola.at/#sipos-tibor",
      "name": "Sipos Tibor",
      "jobTitle": "Néptáncoktató · Napraforgók",
      "description": "1988 óta része az életemnek a magyar néptánc. Számomra a tánc nem egyszerűen mozgás vagy hagyományőrzés: egy olyan közeg, amely egyszer már átsegített egy nehéz életszakaszon, azóta pedig közösséget, irányt és folyamatos felfedezést ad. Ma ezt az élményt szeretném továbbadni azoknak, akik most teszik meg az első lépéseiket.",
      "url": "https://tanarok.magyariskola.at/#sipos-tibor",
      "affiliation": {
        "@id": "https://www.magyariskola.at/#school"
      },
      "subjectOf": [
