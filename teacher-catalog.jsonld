    {
      "@type": "Person",
      "@id": "https://tanarok.magyariskola.at/#banhalmi-norbert",
      "name": "Bánhalmi Norbert",
      "jobTitle": "Fotóművész · alkalmazott fotográfus · kurátor · oktató",
      "description": "Fotósként és oktatóként azt keresem, hogyan lesz a technikából saját látásmód, egy jól elkészített képből pedig valódi történet. Gyerekekkel és felnőttekkel egyaránt dolgozom; a fényképezést nem pusztán eszközhasználatként, hanem figyelemként és önkifejezésként tanítom.",
      "url": "https://tanarok.magyariskola.at/#banhalmi-norbert",
